{
  "name": "torquemedic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TorqueMedic — OBD-II diagnostic and repair assistant",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/make-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "check:protocol": "esbuild scripts/protocol-check.ts --bundle --platform=node --format=esm --outfile=.check/check.mjs && node .check/check.mjs",
    "check:host": "node scripts/host-check.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check": "npm run check:protocol && npm run check:host && npm run check:versions && npm run build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "icons:android": "node scripts/make-android-assets.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/splash-screen": "^7.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
