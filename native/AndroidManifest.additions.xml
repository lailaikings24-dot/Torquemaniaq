<!--
  Merge these into android/app/src/main/AndroidManifest.xml, inside <manifest>.

  BLUETOOTH_SCAN/CONNECT cover Android 12+. ACCESS_FINE_LOCATION is only needed
  for discovery on Android 11 and older, hence maxSdkVersion. declare "neverForLocation"
  so Play does not treat the app as a location tracker.
-->
<uses-permission android:name="android.permission.BLUETOOTH_SCAN"
    android:usesPermissionFlags="neverForLocation" />
<uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
    android:maxSdkVersion="30" />

<uses-feature android:name="android.hardware.bluetooth" android:required="false" />
<uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
