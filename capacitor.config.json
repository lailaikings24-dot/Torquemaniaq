{
  "appId": "com.torquemedic.app",
  "appName": "TorqueMedic",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0b0f14"
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0b0f14",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0b0f14",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
